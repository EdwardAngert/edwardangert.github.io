---
export interface Props {
  pathname: string;
}

const { pathname } = Astro.props;

interface BreadcrumbItem {
  label: string;
  href: string;
  /** False for structural path segments that have no page of their own. */
  linkable: boolean;
}

/**
 * Paths that exist only as URL structure, with no page behind them.
 *
 * Breadcrumbs are built by splitting the URL, so these get an entry even
 * though nothing is served there, and linking them 404s. Everything else
 * that appears mid-path (`/docs/pi-hole/`, `/portfolio/`, `/blog/`) is a
 * real page and should stay linkable.
 *
 * A short hand-kept list rather than something derived: routes come from
 * several places here, including plugin-generated ones that no single
 * collection knows about. `pnpm lint:links` fails if this goes stale, which
 * is the cheaper way to keep it honest.
 */
const NON_PAGE_PATHS = new Set(['/docs', '/about']);

/**
 * Section roots, which the sidebar cannot name usefully.
 *
 * A sidebar labels its section root relative to the group it sits in, so
 * `/portfolio/` is "Overview" and `/blog/` is "All posts". Both read fine in
 * a sidebar and wrong in a breadcrumb trail. `/docs` has no sidebar entry at
 * all, being pure URL structure.
 *
 * Everything below a section root takes its label from the sidebar, so this
 * list covers the roots only, rather than every page on the site.
 */
const SEGMENT_OVERRIDES: Record<string, string> = {
  docs: 'Documentation',
  'pi-hole': 'Pi-hole',
  portfolio: 'Portfolio',
  blog: 'Blog',
};

type SidebarEntry =
  | { type: 'link'; label: string; href: string }
  | { type: 'group'; label: string; entries: SidebarEntry[] };

/**
 * Curated short labels, taken from the sidebar Starlight already built for
 * this route.
 *
 * These used to be a hand-kept map, which had drifted: `block-allow-lists`
 * read "Block Lists" in the breadcrumb and "Block and Allow Lists" in the
 * sidebar, and `pihole-install` had no entry at all so it rendered as
 * "Pihole Install". Reading the sidebar means one curated name per page,
 * defined once in `astro.config.mjs`, and a new page is labelled correctly
 * without touching this file.
 */
function sidebarLabels(entries: SidebarEntry[], into = new Map<string, string>()) {
  for (const entry of entries) {
    if (entry.type === 'group') sidebarLabels(entry.entries, into);
    else if (entry.href) into.set(entry.href.replace(/\/+$/, ''), entry.label);
  }
  return into;
}

const labels = sidebarLabels(
  (Astro.locals?.starlightRoute?.sidebar ?? []) as unknown as SidebarEntry[]
);

function generateBreadcrumbs(path: string): BreadcrumbItem[] {
  const breadcrumbs: BreadcrumbItem[] = [
    { label: 'Home', href: '/', linkable: true }
  ];

  const segments = path.replace(/^\/+|\/+$/g, '').split('/').filter(Boolean);

  let currentPath = '';

  for (const segment of segments) {
    currentPath += `/${segment}`;

    const label =
      SEGMENT_OVERRIDES[segment] ??
      labels.get(currentPath) ??
      // Last resort: title-case the URL segment.
      segment.replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase());

    breadcrumbs.push({
      label,
      href: currentPath,
      linkable: !NON_PAGE_PATHS.has(currentPath),
    });
  }

  return breadcrumbs;
}

const breadcrumbs = generateBreadcrumbs(pathname);

/**
 * BreadcrumbList structured data, so search engines can render the hierarchy
 * instead of a bare URL.
 *
 * Skipped on blog posts: starlight-blog already emits its own BreadcrumbList
 * there, and two competing trails for one page is worse than one.
 * `item` is omitted for entries that are not real pages, which is what
 * schema.org expects for a crumb with nothing to link to. The current page
 * still gets an `item` pointing at its own URL: Google Search Console flags
 * a trailing crumb without one as a missing required field.
 */
const site = Astro.site?.origin ?? '';
const emitStructuredData = !pathname.startsWith('/blog/');
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.linkable
      ? { item: `${site}${item.href === '/' ? '/' : `${item.href}/`}` }
      : {}),
  })),
};
---

{emitStructuredData && (
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
)}

{breadcrumbs.length > 1 && (
  <nav aria-label="Breadcrumb" class="breadcrumbs">
    <ol>
      {breadcrumbs.map((item, index) => (
        <li>
          {index < breadcrumbs.length - 1 ? (
            <>
              {item.linkable ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span class="not-a-page">{item.label}</span>
              )}
              <svg 
                width="16" 
                height="16" 
                viewBox="0 0 24 24" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2"
                aria-hidden="true"
                class="separator"
              >
                <polyline points="9,18 15,12 9,6"/>
              </svg>
            </>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .breadcrumbs {
    margin: 1rem 0;
    font-size: 0.875rem;
  }
  
  .breadcrumbs ol {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  
  .breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .breadcrumbs a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  
  .breadcrumbs a:hover {
    color: var(--sl-color-text);
    text-decoration: underline;
  }
  
  .breadcrumbs span[aria-current="page"] {
    color: var(--sl-color-text);
    font-weight: 500;
  }
  
  .separator {
    color: var(--sl-color-gray-4);
    flex-shrink: 0;
  }
  
  @media (max-width: 768px) {
    .breadcrumbs {
      font-size: 0.8rem;
    }
    
    .breadcrumbs ol {
      gap: 0.125rem;
    }
  }
</style>