---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/SiteTitle.astro';

// Replaces starlight-blog's SiteTitle override, which can only render the Blog
// link. This renders the same link plus Portfolio and Docs, styled the same way. Docs points
// at the Pi-hole guide because that is the whole Documentation sidebar group.
const links = [
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Docs', href: '/docs/pi-hole/' },
  { label: 'Blog', href: '/blog/' },
];
---

<span class="full-name"><Default {...Astro.props}><slot /></Default></span>
<a class="short-name" href="/">Edward</a>
<nav aria-label="Main">
  {links.map((l) => <a href={l.href}>{l.label}</a>)}
</nav>

<style>
  nav {
    border-inline-start: 1px solid var(--sl-color-gray-5);
    display: none;
    gap: 1rem;
    margin-inline-start: 1rem;
    min-inline-size: 0;
    padding-inline-start: 1rem;
  }

  @media (min-width: 50rem) {
    nav {
      align-items: center;
      display: flex;
    }
  }

  a {
    color: var(--sl-color-text-accent);
    font-weight: 600;
    min-inline-size: 0;
    overflow: hidden;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  a:hover {
    text-decoration: underline;
  }

  .full-name {
    display: contents;
  }

  .short-name {
    display: none;
  }

  /* Pages without a sidebar (the home page) have no menu button on phones, so
     show the links there too. */
  @media (max-width: 49.99rem) {
    :global(:root:not([data-has-sidebar])) nav {
      align-items: center;
      display: flex;
    }
  }

  /* Narrow phones: "Edward | Portfolio | Docs | Blog |" beside search. */
  @media (max-width: 30rem) {
    :global(:root:not([data-has-sidebar])) .full-name {
      display: none;
    }
    :global(:root:not([data-has-sidebar])) .short-name {
      display: block;
      font-size: var(--sl-text-lg);
      overflow: visible;
    }
    :global(:root:not([data-has-sidebar])) nav {
      border-inline-end: 1px solid var(--sl-color-gray-5);
      gap: 0;
      margin-inline-start: 0.6rem;
      padding-inline: 0;
      font-size: var(--sl-text-sm);
    }
    :global(:root:not([data-has-sidebar])) nav a {
      padding-inline: 0.6rem;
    }
    :global(:root:not([data-has-sidebar])) nav a + a {
      border-inline-start: 1px solid var(--sl-color-gray-5);
    }
  }

  /* 320px: a little less space around each link. */
  @media (max-width: 22rem) {
    :global(:root:not([data-has-sidebar])) nav {
      margin-inline-start: 0.4rem;
    }
    :global(:root:not([data-has-sidebar])) nav a {
      padding-inline: 0.4rem;
    }
  }
</style>
