---
// Not numbers: the things I'd want a stranger to know first.
const stats = [
  {
    value: 'Everyone',
    label: 'has something to share.',
  },
  {
    value: 'Written down',
    label: 'and findable is better than perfect.',
  },
  {
    value: 'Ship it',
    label: 'Get good stuff out, then make it better, then make it better.',
  },
  {
    value: 'Every detail.',
    label: "Tell me the long version of your favorite story.",
  },
];
---

<ul class="stats not-content">
  {stats.map((s) => (
    <li>
      <strong>{s.value}</strong>
      <span>{s.label}</span>
    </li>
  ))}
</ul>

<style>
  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.25rem 0 0.25rem 1rem;
    border-inline-start: 4px solid var(--edward-highlight);
    color: var(--sl-color-gray-2);
  }
  strong {
    font-size: var(--sl-text-3xl);
    line-height: 1.1;
    color: var(--sl-color-white);
  }
  span {
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }
  /* A small lift, like the work sample tiles. Pointer devices only, so a tap
     doesn't leave a card stuck in the raised state. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    li {
      transition: transform 0.15s;
    }
    li:hover {
      transform: translateY(-2px);
    }
  }
</style>
